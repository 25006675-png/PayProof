NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# This OAuth client must allow each app callback, for example http://localhost:3000/auth/callback.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1

# Generate separate high-entropy values of at least 32 characters. Never expose them to the browser.
PAYPROOF_SESSION_SECRET=
ZKLOGIN_SALT_MASTER_KEY=
GOOGLE_OAUTH_CLIENT_ID=
ZKLOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
QDRANT_URL=
QDRANT_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LEGAL_COLLECTION=payproof_malaysia_law_v1
BACKEND_STORE=memory
PORT=8787
PAYPROOF_DEMO_MODE=false
INVITE_BASE_URL=http://localhost:3000/orders
FRONTEND_ORIGIN=http://localhost:3000
SUI_ESCROW_VERIFIER_ENABLED=false
# Brevo verifies a single sender address, so it can reach any recipient without a mail domain.
# Brevo is preferred when configured, followed by SMTP and then Resend.
BREVO_API_KEY=
RESEND_API_KEY=
INVITATION_EMAIL_FROM=PayProof <orders@your-verified-domain.example>
# Optional SMTP sender. Used only when Brevo is not configured.
# Prefer 587 with STARTTLS: TLS-scanning antivirus (Avast Mail Shield and
# similar) presents an untrusted certificate on implicit-TLS 465 and the send
# fails with "unable to verify the first certificate".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_ESCROW_PACKAGE_ID=0x09016642916e5558256e4d5dbc2745c4eb4585c0f163a7f96d99438c77960501
# Comma-separated package IDs for existing escrows that must remain verifiable.
SUI_LEGACY_ESCROW_PACKAGE_IDS=0x132dda3d655724c5a667a4454baef3db3f6529ecf42ddb65132e1d9d14fd6f30
